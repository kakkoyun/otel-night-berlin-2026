package main

import (
	"fmt"
	slog "log/slog"
	"os"
	"time"
)

func init() {
	opts := &slog.HandlerOptions{Level: slog.LevelInfo}
	handler := slog.NewJSONHandler(os.Stdout, opts)
	slog.SetDefault(slog.New(handler))
}

func calculateSum(a, b int) int {
	start := time.Now()
	slog.Info("function entry", "func", "calculateSum", "a", a, "b", b)
	defer func() {
		slog.Info("function exit", "func", "calculateSum", "duration", time.Since(start))
	}()
	time.Sleep(50 * time.Millisecond)
	return a + b
}

func processData(name string, items []string) error {
	start := time.Now()
	slog.Info("function entry", "func", "processData", "name", name, "items", items)
	defer func() {
		slog.Info("function exit", "func", "processData", "duration", time.Since(start))
	}()
	time.Sleep(100 * time.Millisecond)
	if len(items) == 0 {
		return fmt.Errorf("no items to process for %s", name)
	}
	fmt.Printf("Processed %d items for %s\n", len(items), name)
	return nil
}

func simpleOperation() {
	start := time.Now()
	slog.Info("function entry",
		// Simulate work
		"func", "simpleOperation")
	defer func() {
		slog.Info("function exit", "func", "simpleOperation", "duration", time.Since(start))
	}()
	time.Sleep(25 * time.Millisecond)
	fmt.Println("Simple operation completed")
}

func main() {
	fmt.Println("Hello OTel Night Berlin")

	result := calculateSum(10, 20)
	fmt.Printf("Sum: %d\n", result)

	items := []string{"item1", "item2", "item3"}
	if err := processData("demo", items); err != nil {
		fmt.Printf("Error: %v\n", err)
	}

	simpleOperation()
}
